{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "891d79a2e4b972a15174afafc4169c3d",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"compatibility_date": "2025-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "9fab0606-79d6-44f0-913f-2302ca964757",
			"database_name": "herramienta-db",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "LoginRateLimiter",
				"name": "LOGIN_RATE_LIMITER"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "7d8894327b3d4e43a51b06225eeef303"
		}
	],
	"main": "./src/server.tsx",
	"migrations": [
		{
			"new_sqlite_classes": ["LoginRateLimiter"],
			"tag": "v1"
		}
	],
	"name": "herramienta",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"secrets_store_secrets": [
		{
			"binding": "AT_SECRET",
			"secret_name": "ACCESS_TOKEN_SECRET",
			"store_id": "2e1630d6bfa8460e838cf7fa87c61ed4"
		},
		{
			"binding": "RT_SECRET",
			"secret_name": "REFRESH_TOKEN_SECRET",
			"store_id": "2e1630d6bfa8460e838cf7fa87c61ed4"
		}
	]
}
