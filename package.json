{
	"dependencies": {
		"@cantoo/pdf-lib": "2.11.1",
		"@hono/zod-validator": "0.9.1",
		"@tailwindcss/vite": "4.3.3",
		"autopen": "1.0.0",
		"bcryptjs": "3.0.3",
		"daisyui": "5.7.50",
		"dayjs": "1.11.23",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.13",
		"tailwindcss": "4.3.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vite-plugin": "1.64.0",
		"@types/node": "26.6.5",
		"drizzle-kit": "0.31.11",
		"signature_pad": "5.1.4",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vite-ssr-components": "0.8.0",
		"vitest": "5.0.5",
		"wrangler": "4.151.1"
	},
	"name": "herramienta",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"build": "vite build",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"check": "pnpm typecheck && pnpm lint",
		"clean": "rm -rf dist",
		"deploy": "$npm_execpath run build && wrangler deploy",
		"dev": "vite",
		"kv:seed:local": "wrangler kv key put reg07.pdf --binding=KV --local --path=public/reg07.pdf",
		"kv:seed:remote": "wrangler kv key put reg07.pdf --binding=KV --remote --path=public/reg07.pdf",
		"lint": "biome check src tests",
		"lint:fix": "biome check --write src tests",
		"migrate:local": "wrangler d1 migrations apply herramienta-db --local",
		"migrate:remote": "wrangler d1 migrations apply herramienta-db --remote",
		"preview": "$npm_execpath run build && vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"type": "module"
}
